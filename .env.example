# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth_db

# Ollama Local LLM & Embedding Settings
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

# LLM Provider Configuration
# Options: 'ollama' (default local runtime), 'anthropic' (cloud Claude), or 'gemini' (Google Gemini)
LLM_PROVIDER=ollama

# Anthropic Cloud LLM Configuration (required when LLM_PROVIDER=anthropic)
# Safe placeholder: replace with your real sk-ant-... key in your private .env file
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini Cloud LLM Configuration (required when LLM_PROVIDER=gemini)
# Obtain a free API key from https://aistudio.google.com/apikey (no billing required)
# Safe placeholder: replace with your real API key in your private .env file
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Claude Agent SDK Prerequisites (for agent mode `use_agent=True`):
# The official Claude Agent SDK (`claude-agent-sdk`) runs on the Claude Code runtime.
# For live un-mocked agent execution, the host requires an authenticated Claude Code
# session (`claude login` / `/login`) in addition to ANTHROPIC_API_KEY.
# Without active runtime credentials, agent queries return HTTP 401 Unauthorized.

# API Server Settings
PORT=8000
HOST=127.0.0.1

