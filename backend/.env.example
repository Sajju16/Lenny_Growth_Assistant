# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth_db

# Ollama Local LLM & Embedding Settings
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
# Bounded timeout configuration for local CPU inference (seconds)
# Default chat: 180s (3m); Ship 30 for 30 essay generation: 420s (7m)
OLLAMA_CHAT_TIMEOUT=180.0
OLLAMA_ESSAY_TIMEOUT=420.0

# LLM Provider Configuration
# Options: 'ollama' (default local runtime) or 'anthropic' (cloud Claude)
LLM_PROVIDER=ollama

# Anthropic Cloud LLM / Claude Agent Configuration (required when LLM_PROVIDER=anthropic)
# Safe placeholder: replace with your real sk-ant-... key in your private .env file
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# API Server Settings
PORT=8000
HOST=127.0.0.1
